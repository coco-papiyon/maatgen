{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maatgen.local/schema/command-approval.schema.json",
  "title": "CommandApproval",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "sessionId", "runId", "providerRequestId", "command", "shell", "workingDirectory", "segments", "status", "factors", "createdAt"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "sessionId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "providerRequestId": { "type": "string", "minLength": 1 },
    "command": { "type": "string", "minLength": 1 },
    "shell": { "type": "string", "minLength": 1 },
    "workingDirectory": { "type": "string", "minLength": 1 },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "command", "argv", "allowed"],
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "command": { "type": "string" },
          "argv": { "type": "array", "items": { "type": "string" } },
          "allowed": { "type": "boolean" }
        }
      }
    },
    "status": { "enum": ["pending", "approved", "denied", "cancelled", "expired"] },
    "risk": { "enum": ["safe", "low", "high", "critical"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "summary": { "type": "string" },
    "factors": { "type": "array", "items": { "type": "string" } },
    "decision": { "enum": ["allow_once", "allow_session", "allow_permanent", "deny"] },
    "scope": { "enum": ["once", "session", "permanent"] },
    "source": { "enum": ["config", "ai", "human", "system"] },
    "ruleArgv": { "type": "array", "items": { "type": "string" } },
    "createdAt": { "type": "string", "format": "date-time" },
    "decidedAt": { "type": "string", "format": "date-time" }
  }
}
