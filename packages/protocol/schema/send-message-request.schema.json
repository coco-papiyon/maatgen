{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maatgen.dev/schema/send-message-request.schema.json",
  "title": "SendMessageRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["message"],
  "properties": {
    "message": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "reasoningEffort": { "type": "string", "enum": ["low", "medium", "high", "xhigh", "max"] },
    "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 7200 },
    "autoApprove": { "type": "boolean" },
    "autoRetryOfRunId": { "type": "string", "minLength": 1 }
  }
}
