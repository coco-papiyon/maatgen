{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maatgen.dev/schema/create-session-request.schema.json",
  "title": "CreateSessionRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["agent", "workspace"],
  "properties": {
    "agent": { "enum": ["codex", "claude", "copilot"] },
    "workspace": { "type": "string", "minLength": 1 },
    "triggerSource": { "enum": ["manual", "github_monitor"] },
    "githubMonitorEvent": { "type": "string", "minLength": 1 },
    "githubRuleId": { "type": "string", "minLength": 1 },
    "githubItemKind": { "enum": ["issue", "pull_request"] },
    "githubItemNumber": { "type": "integer" }
  }
}
