{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maatgen.local/schema/session-event.schema.json",
  "title": "SessionEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "sessionId",
    "sequence",
    "timestamp",
    "schemaVersion",
    "source",
    "type",
    "data"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "sessionId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "schemaVersion": { "const": 2 },
    "source": { "enum": ["user", "codex", "claude", "copilot", "manager"] },
    "type": {
      "enum": [
        "user_prompt",
        "assistant_message",
        "reasoning_summary",
        "command_started",
        "command_completed",
        "command_approval_requested",
        "command_approval_decided",
        "file_change_reported",
        "usage_reported",
        "change_detected",
        "checkpoint_created",
        "change_restored",
        "run_started",
        "run_completed",
        "run_failed",
        "run_cancelled",
        "error"
      ]
    },
    "data": true
  }
}
