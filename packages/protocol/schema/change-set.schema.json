{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maatgen.local/schema/change-set.schema.json",
  "title": "ChangeSet",
  "type": "object",
  "additionalProperties": false,
  "required": ["sessionId", "runId", "checkpointId", "beforeTree", "afterTree", "files"],
  "properties": {
    "sessionId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "checkpointId": { "type": "string", "minLength": 1 },
    "beforeTree": { "type": "string", "minLength": 1 },
    "afterTree": { "type": "string", "minLength": 1 },
    "files": {
      "type": "array",
      "items": { "$ref": "#/$defs/fileChange" }
    }
  },
  "$defs": {
    "restoreStatus": {
      "enum": ["changed", "partially_restored", "restored", "conflict"]
    },
    "hunkStatus": {
      "enum": ["changed", "restored", "conflict"]
    },
    "changeHunk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "oldStart", "oldLines", "newStart", "newLines", "originalText", "modifiedText", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "oldStart": { "type": "integer", "minimum": 0 },
        "oldLines": { "type": "integer", "minimum": 0 },
        "newStart": { "type": "integer", "minimum": 0 },
        "newLines": { "type": "integer", "minimum": 0 },
        "originalText": { "type": "string" },
        "modifiedText": { "type": "string" },
        "status": { "$ref": "#/$defs/hunkStatus" }
      }
    },
    "fileChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "restoreMode", "status", "hunks"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "oldPath": { "type": "string", "minLength": 1 },
        "newPath": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["modify", "add", "delete", "rename", "binary", "mode_change"] },
        "original": { "type": "string" },
        "modified": { "type": "string" },
        "restoreMode": { "enum": ["hunk", "file"] },
        "status": { "$ref": "#/$defs/restoreStatus" },
        "hunks": {
          "type": "array",
          "items": { "$ref": "#/$defs/changeHunk" }
        }
      }
    }
  }
}
