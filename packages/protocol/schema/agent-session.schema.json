{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maatgen.local/schema/agent-session.schema.json",
  "title": "AgentSession",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "agent", "workspace", "worktree", "baseCommit", "status", "createdAt"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "agent": { "const": "codex" },
    "workspace": { "type": "string", "minLength": 1 },
    "worktree": { "type": "string", "minLength": 1 },
    "baseCommit": { "type": "string", "minLength": 1 },
    "codexThreadId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["active", "closed"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "closedAt": { "type": "string", "format": "date-time" },
    "cleanupStatus": { "enum": ["not_started", "pending", "completed", "failed"] },
    "cleanupError": { "type": "string" },
    "cleanupAttempts": { "type": "integer", "minimum": 0 },
    "cleanupUpdatedAt": { "type": "string", "format": "date-time" }
  }
}
