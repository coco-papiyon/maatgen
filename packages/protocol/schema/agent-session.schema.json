{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maatgen.local/schema/agent-session.schema.json",
  "title": "AgentSession",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "agent", "workspace", "status", "triggerSource", "createdAt"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "agent": { "enum": ["codex", "claude", "copilot"] },
    "workspace": { "type": "string", "minLength": 1 },
    "agentThreadId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["active", "closed"] },
    "triggerSource": { "enum": ["manual", "github_monitor"] },
    "githubMonitorEvent": { "type": "string", "minLength": 1 },
    "githubRuleId": { "type": "string", "minLength": 1 },
    "githubItemKind": { "enum": ["issue", "pull_request"] },
    "githubItemNumber": { "type": "integer" },
    "createdAt": { "type": "string", "format": "date-time" },
    "closedAt": { "type": "string", "format": "date-time" },
    "firstPrompt": { "type": "string", "minLength": 1 },
    "activeRunStatus": { "enum": ["queued", "starting", "running", "waiting_for_approval"] }
  }
}
