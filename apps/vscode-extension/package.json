{
  "name": "maatgen",
  "displayName": "Maatgen",
  "description": "Run and review coding-agent sessions from VS Code.",
  "version": "0.1.0",
  "private": true,
  "publisher": "coco-papiyon",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:maatgen.sessions",
    "onCommand:maatgen.refresh"
  ],
  "contributes": {
    "viewContainers": {
      "panel": [
        {
          "id": "maatgen",
          "title": "Maatgen",
          "icon": "media/maat.svg"
        }
      ]
    },
    "configuration": {
      "title": "Maatgen",
      "properties": {
        "maatgen.managerUrl": {
          "type": "string",
          "default": "http://127.0.0.1:3100",
          "description": "Agent Manager base URL"
        },
        "maatgen.managerAuthToken": {
          "type": "string",
          "default": "maatgen-local-development-token",
          "description": "Agent Manager bearer token",
          "scope": "machine-overridable"
        }
      }
    },
    "commands": [
      {
        "command": "maatgen.refresh",
        "title": "Maatgen: Refresh"
      }
    ],
    "views": {
      "maatgen": [
        {
          "type": "webview",
          "id": "maatgen.sessions",
          "name": "Sessions"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/vscode": "^1.96.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  }
}
