{
  "name": "maatgen",
  "displayName": "Maatgen",
  "description": "Run and review coding-agent sessions from VS Code.",
  "version": "0.1.0",
  "private": true,
  "publisher": "coco-papiyon",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:maatgen.sessions",
    "onCommand:maatgen.refresh",
    "onCommand:maatgen.saveResponse"
  ],
  "contributes": {
    "viewContainers": {
      "panel": [
        {
          "id": "maatgen",
          "title": "Maatgen",
          "icon": "media/maat.png"
        }
      ]
    },
    "configuration": {
      "title": "Maatgen",
      "properties": {
        "maatgen.managerUrl": {
          "type": "string",
          "default": "http://127.0.0.1:3100",
          "description": "Agent Manager base URL"
        }
      }
    },
    "commands": [
      {
        "command": "maatgen.refresh",
        "title": "Maatgen: Refresh"
      },
      {
        "command": "maatgen.focusPanel",
        "title": "Maatgen: Focus Panel",
        "icon": "media/maat.png"
      },
      {
        "command": "maatgen.restoreHunk",
        "title": "Maatgen: Restore Hunk to Checkpoint",
        "enablement": "resourceScheme == maatgen-checkpoint"
      },
      {
        "command": "maatgen.restoreFile",
        "title": "Maatgen: Restore File to Checkpoint",
        "enablement": "resourceScheme == maatgen-checkpoint"
      },
      {
        "command": "maatgen.saveResponse",
        "title": "Maatgen: Save Agent Response as Markdown",
        "icon": "$(save-as)",
        "enablement": "resourceScheme == maatgen-response"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "maatgen.focusPanel",
          "when": "true"
        }
      ],
      "editor/title": [
        {
          "command": "maatgen.focusPanel",
          "group": "navigation",
          "when": "resourceScheme == file"
        },
        {
          "command": "maatgen.saveResponse",
          "group": "navigation",
          "when": "resourceScheme == maatgen-response"
        }
      ]
    },
    "views": {
      "maatgen": [
        {
          "type": "webview",
          "id": "maatgen.sessions",
          "name": "Sessions"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/vscode": "^1.96.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  }
}
